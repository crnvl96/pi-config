{
  "lastChangelogVersion": "0.80.10",
  "npmCommand": [
    "mise",
    "exec",
    "node@24",
    "--",
    "npm"
  ],
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:pi-omplike-advisor"
  ],
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-pro",
  "defaultThinkingLevel": "high",
  "showCacheMissNotices": true,
  "hideThinkingBlock": true,
  "treeFilterMode": "no-tools",
  "theme": "dark",
  "quietStartup": true,
  "editorPaddingX": 1,
  "outputPad": 1,
  "markdown": {
    "codeBlockIndent": ""
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32768
  },
  "thinkingBudgets": {
    "minimal": 2048,
    "low": 4096,
    "medium": 10240,
    "high": 32768
  },
  "enabledModels": [
    "deepseek/deepseek-v4-flash",
    "deepseek/deepseek-v4-pro",
    "cloudflare-ai-gateway/gpt-5.6-sol",
    "cloudflare-ai-gateway/gpt-5.6-luna",
    "cloudflare-ai-gateway/gpt-5.6-terra",
    "cloudflare-ai-gateway/claude-fable-5",
    "cloudflare-ai-gateway/claude-opus-4-8",
    "cloudflare-ai-gateway/claude-sonnet-5",
    "cloudflare-ai-gateway/claude-haiku-4-5",
    "cloudflare-ai-gateway/workers-ai/@cf/zai-org/glm-5.2",
    "cloudflare-ai-gateway/workers-ai/@cf/moonshotai/kimi-k2.6"
  ]
}