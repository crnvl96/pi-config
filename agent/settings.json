{
  "lastChangelogVersion": "0.80.6",
  "npmCommand": ["mise", "exec", "node@24", "--", "npm"],
  "packages": ["npm:@ff-labs/pi-fff", "npm:@charmland/pi-hyper-provider"],
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-pro",
  "defaultThinkingLevel": "high",
  "showCacheMissNotices": true,
  "hideThinkingBlock": true,
  "treeFilterMode": "no-tools",
  "theme": "dark",
  "quietStartup": true,
  "editorPaddingX": 0,
  "outputPad": 0,
  "markdown": {
    "codeBlockIndent": ""
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32768
  },
  "thinkingBudgets": {
    "minimal": 2048,
    "low": 4096,
    "medium": 10240,
    "high": 32768
  }
}
