{
  "lastChangelogVersion": "0.83.0",
  "npmCommand": [
    "mise",
    "exec",
    "node@24",
    "--",
    "npm"
  ],
  "packages": [
    "git:github.com/earendil-works/pi-review-loop"
  ],
  "defaultProvider": "cloudflare-ai-gateway",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "xhigh",
  "showCacheMissNotices": true,
  "hideThinkingBlock": true,
  "treeFilterMode": "no-tools",
  "theme": "dark",
  "quietStartup": true,
  "editorPaddingX": 1,
  "outputPad": 1,
  "markdown": {
    "codeBlockIndent": ""
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32768
  },
  "thinkingBudgets": {
    "minimal": 2048,
    "low": 4096,
    "medium": 10240,
    "high": 32768
  },
  "enabledModels": [
    "deepseek/deepseek-v4-pro",
    "cloudflare-ai-gateway/gpt-5.6-sol",
    "cloudflare-ai-gateway/gpt-5.6-luna",
    "cloudflare-ai-gateway/gpt-5.6-terra"
  ]
}